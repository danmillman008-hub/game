{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimo.local/schemas/content-pack.schema.json",
  "title": "Mimo offline content pack",
  "description": "قرارداد بستهٔ محتوایی آفلاین؛ برگرفته از HANDOFF/02 و HANDOFF/03.",
  "type": "object",
  "required": [
    "publishSetVersion",
    "tracks"
  ],
  "properties": {
    "publishSetVersion": {
      "type": "integer",
      "description": "نسخهٔ پایهٔ محتوا (در Mimo 753 بود)"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "default": "fa-IR"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/track"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "track": {
      "type": "object",
      "required": [
        "id",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "version": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "tutorials"
      ],
      "properties": {
        "index": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "tutorials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tutorialRef"
          }
        }
      }
    },
    "tutorialRef": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "hasProgress": {
          "type": "boolean"
        }
      }
    },
    "tutorial": {
      "type": "object",
      "required": [
        "id",
        "chapters"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "version": {
          "type": "integer"
        },
        "type": {
          "enum": [
            "course",
            "practice"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chapter"
          }
        }
      }
    },
    "chapter": {
      "type": "object",
      "required": [
        "id",
        "lessons"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "contentType",
        "body"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "contentType": {
          "enum": [
            "interactive",
            "executableFiles"
          ]
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "body": {
          "type": "string",
          "description": "سند درس در DSL Mimo. تعامل‌های مجاز: fillTheGap، validatedInput (داخل <code>)، selection، و تعامل درون‌متنی EXT-01.",
          "minLength": 1
        },
        "feedback": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
