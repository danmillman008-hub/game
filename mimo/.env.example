# نمونهٔ متغیرهای محیطی پیش‌نمایش — هیچ رمز و کلیدی در این فایل نیست.
PREVIEW_PORT=4000
EPM_PORT=8765
LH_PORT=3000

# محل داده (پیش‌فرض: mimo/.runtime زیرپوشه‌ها)
EPM_DATA_DIR=./.runtime/epm-data
LH_DATA_DIR=./.runtime/lh-data
LH_AUTH_FILE=./.runtime/lh-auth.json

# EPM: در پیش‌نمایش محلی احراز هویت خاموش است. برای هر استفادهٔ دیگر 1 کنید.
EPM_AUTH=0

# LearnHarness: کلید مدل را در صفحهٔ تنظیمات خودش وارد کنید، نه اینجا.
# OPENAI_API_KEY=
