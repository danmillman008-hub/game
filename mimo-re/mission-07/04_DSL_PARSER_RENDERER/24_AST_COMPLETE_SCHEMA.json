{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "mimo.lesson.ast.m7.json",
 "title": "Mimo lesson AST (Mission 7, offset-corrected)",
 "type": "object",
 "required": [
  "modules"
 ],
 "properties": {
  "modules": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/Module"
   }
  }
 },
 "$defs": {
  "Visibility": {
   "enum": [
    "ALWAYS",
    "CORRECT",
    "WRONG"
   ]
  },
  "Span": {
   "type": "object",
   "required": [
    "start",
    "end"
   ],
   "properties": {
    "start": {
     "type": "integer",
     "description": "character offset in owning text"
    },
    "end": {
     "type": "integer"
    },
    "space": {
     "const": "STYLE_SPAN"
    }
   }
  },
  "Module": {
   "oneOf": [
    {
     "$ref": "#/$defs/Paragraph"
    },
    {
     "$ref": "#/$defs/Code"
    },
    {
     "$ref": "#/$defs/Selection"
    },
    {
     "$ref": "#/$defs/Image"
    },
    {
     "$ref": "#/$defs/Webview"
    },
    {
     "$ref": "#/$defs/Database"
    }
   ]
  },
  "Base": {
   "type": "object",
   "properties": {
    "visibility": {
     "$ref": "#/$defs/Visibility"
    },
    "sourceLine": {
     "type": "integer"
    }
   }
  },
  "Paragraph": {
   "allOf": [
    {
     "$ref": "#/$defs/Base"
    }
   ],
   "properties": {
    "kind": {
     "const": "PARAGRAPH"
    },
    "inlines": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Inline"
     }
    }
   }
  },
  "Inline": {
   "oneOf": [
    {
     "type": "object",
     "properties": {
      "kind": {
       "const": "TEXT"
      },
      "value": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "properties": {
      "kind": {
       "enum": [
        "BR",
        "EM",
        "STRONG"
       ]
      }
     }
    },
    {
     "type": "object",
     "properties": {
      "kind": {
       "const": "SPAN"
      },
      "children": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/Inline"
       }
      }
     }
    },
    {
     "type": "object",
     "properties": {
      "kind": {
       "const": "A"
      },
      "href": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "properties": {
      "kind": {
       "const": "CODE"
      },
      "value": {
       "type": "string"
      }
     }
    }
   ]
  },
  "Code": {
   "allOf": [
    {
     "$ref": "#/$defs/Base"
    }
   ],
   "required": [
    "content"
   ],
   "properties": {
    "kind": {
     "const": "CODE"
    },
    "codelang": {
     "type": "string",
     "default": "none"
    },
    "content": {
     "type": "string",
     "description": "offset space for interactions"
    },
    "runs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TextRun"
     }
    },
    "interactions": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Interaction"
     }
    },
    "output": {
     "$ref": "#/$defs/Output"
    },
    "collapsibleLines": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "startLineIndex",
       "endLineIndex"
      ],
      "properties": {
       "startLineIndex": {
        "type": "integer"
       },
       "endLineIndex": {
        "type": "integer"
       }
      }
     }
    }
   }
  },
  "TextRun": {
   "type": "object",
   "properties": {
    "type": {
     "type": "string"
    },
    "value": {
     "type": "string"
    }
   }
  },
  "Interaction": {
   "type": "object",
   "required": [
    "type",
    "startIndex",
    "endIndex"
   ],
   "properties": {
    "type": {
     "enum": [
      "FILL_THE_GAP",
      "SELECTION",
      "SPELL",
      "VALIDATED_INPUT"
     ]
    },
    "isDefault": {
     "type": "boolean",
     "default": false
    },
    "startIndex": {
     "type": "integer",
     "minimum": 0
    },
    "endIndex": {
     "type": "integer",
     "minimum": 0
    },
    "gapSpan": {
     "$ref": "#/$defs/Span",
     "description": "startIndex..endIndex inside Code.content"
    },
    "options": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Option"
     }
    },
    "expected": {
     "type": "string",
     "description": "content.substring(startIndex,endIndex)"
    }
   }
  },
  "Option": {
   "type": "object",
   "required": [
    "label",
    "isCorrect"
   ],
   "properties": {
    "label": {
     "type": "string"
    },
    "isCorrect": {
     "type": "boolean"
    },
    "labelSpan": {
     "$ref": "#/$defs/Span",
     "description": "Option.c/d: style span inside the label, NOT the gap"
    }
   }
  },
  "Output": {
   "oneOf": [
    {
     "type": "object",
     "properties": {
      "kind": {
       "const": "CONSOLE"
      },
      "text": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "properties": {
      "kind": {
       "const": "TABLE"
      },
      "table": {
       "$ref": "#/$defs/Table"
      }
     }
    }
   ]
  },
  "Table": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    },
    "content": {
     "type": "string"
    },
    "rows": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Row"
     }
    }
   }
  },
  "Row": {
   "type": "object",
   "properties": {
    "kind": {
     "enum": [
      "HEADER",
      "DATA"
     ]
    },
    "cells": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "Selection": {
   "allOf": [
    {
     "$ref": "#/$defs/Base"
    }
   ],
   "properties": {
    "kind": {
     "const": "SELECTION"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "label": {
        "type": "string"
       },
       "isCorrect": {
        "type": "boolean"
       },
       "isCode": {
        "type": "boolean"
       }
      }
     }
    }
   }
  },
  "Image": {
   "allOf": [
    {
     "$ref": "#/$defs/Base"
    }
   ],
   "properties": {
    "kind": {
     "const": "IMAGE"
    },
    "src": {
     "type": "string"
    }
   }
  },
  "Webview": {
   "allOf": [
    {
     "$ref": "#/$defs/Base"
    }
   ],
   "properties": {
    "kind": {
     "const": "WEBVIEW"
    },
    "version": {
     "type": "string"
    },
    "style": {
     "type": "string"
    },
    "interaction": {
     "type": "string"
    },
    "content": {
     "type": "string",
     "description": "HTML payload (not parsed by te.*)"
    }
   }
  },
  "Database": {
   "allOf": [
    {
     "$ref": "#/$defs/Base"
    }
   ],
   "properties": {
    "kind": {
     "const": "DATABASE"
    },
    "tables": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Table"
     }
    }
   }
  }
 }
}