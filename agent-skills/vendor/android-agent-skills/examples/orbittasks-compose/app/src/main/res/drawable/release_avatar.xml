<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:endColor="#4F8CFF"
                android:startColor="#8FD9FF" />
            <size
                android:height="64dp"
                android:width="64dp" />
        </shape>
    </item>
    <item
        android:bottom="14dp"
        android:left="18dp"
        android:right="18dp"
        android:top="18dp">
        <shape android:shape="oval">
            <solid android:color="#F7FBFF" />
        </shape>
    </item>
</layer-list>
