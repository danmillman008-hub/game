            ],
            "interactiveContent": "<!DOCTYPE html ><html><body><img src=\"5b4c2316-803a-414b-b9c6-6a4ffa151f71\" visible-if=\"always\" /><p>Welcome to the very last section of the full-stack path. You've come a long way. Not everyone makes it that far.</p><p>You deserve a pat on the back!</p></body></html>"
